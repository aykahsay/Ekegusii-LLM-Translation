    "\n",
    "if os.getcwd() not in sys.path:\n",
    "    sys.path.insert(0, os.getcwd())\n",
    "\n",
    "print(f'Working Directory : {os.getcwd()}')\n",
    "print(f'Python Kernel     : {sys.executable}')\n"
   ]
