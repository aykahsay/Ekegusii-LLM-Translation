  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 16. LoRA Adapter Fusion vs. Sequential Fine-Tuning Comparison\n",
    "\n",
    "This notebook performs a side-by-side comparative analysis of:\n",
    "1. **Sequential Gradient Fine-Tuning** (Model A → Model B / Model C)\n",
    "2. **Instant LoRA Weight Fusion** (Model A + E1 & Model A + E2 merged in 2 seconds)\n",
    "\n",
    "Compares SacreBLEU, chrF++, and Lexical Accuracy metrics across both approaches to generate a publication-ready ablation table."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "\n",
    "import os, sys, gc, torch\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "\n",
    "if os.path.basename(os.getcwd()) == 'notebooks':\n",
    "    os.chdir('..')\n",
    "\n",
    "print(f\"CUDA Available: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import glob\n",
    "from src.experiments.adapter_fusion import run_lora_fusion\n",
    "from src.cli.evaluate import run_evaluate\n",
    "\n",
    "# Locate Model A and E1/E2 adapters\n",
    "model_a_path = sorted(glob.glob('checkpoints/qwen/E10_Model_A_English_Swahili/checkpoint-*'))[-1] if glob.glob('checkpoints/qwen/E10_Model_A_English_Swahili/checkpoint-*') else 'checkpoints/qwen/E10_Model_A_English_Swahili'\n",
    "e1_path = sorted(glob.glob('checkpoints/qwen/E1_English_Ekegusii/checkpoint-*'))[-1] if glob.glob('checkpoints/qwen/E1_English_Ekegusii/checkpoint-*') else 'checkpoints/qwen/E1_English_Ekegusii'\n",
    "e2_path = sorted(glob.glob('checkpoints/qwen/E2_Swahili_Ekegusii/checkpoint-*'))[-1] if glob.glob('checkpoints/qwen/E2_Swahili_Ekegusii/checkpoint-*') else 'checkpoints/qwen/E2_Swahili_Ekegusii'\n",
    "\n",
    "print(f\"📦 Model A Adapter Path : {model_a_path}\")\n",
    "print(f\"📦 E1 Adapter Path      : {e1_path}\")\n",
    "print(f\"📦 E2 Adapter Path      : {e2_path}\")\n",
    "\n",
    "# ⚡ Instant LoRA Weight Fusion (Model A + E1)\n",
    "print(\"\\n⚡ [1/2] Instant Merging Model A + E1 (English-Ekegusii)... \")\n",
    "run_lora_fusion(model_a_path, e1_path, output_merged_dir='checkpoints/qwen/LoRA_Fusion_Model_B')\n",
    "\n",
    "# ⚡ Instant LoRA Weight Fusion (Model A + E2)\n",
    "print(\"\\n⚡ [2/2] Instant Merging Model A + E2 (Swahili-Ekegusii)... \")\n",
    "run_lora_fusion(model_a_path, e2_path, output_merged_dir='checkpoints/qwen/LoRA_Fusion_Model_C')\n",
    "\n",
    "print(\"\\n🎉 INSTANT LORA FUSION MERGING COMPLETE (0 GPU Training Time)! \")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "from src.cli.evaluate import run_evaluate\n",
    "\n",
    "results = []\n",
    "\n",
    "# Evaluate Merged Fusion Model B vs Fine-Tuned Model B\n",
    "models_to_eval = [\n",
    "    (\"Instant LoRA Fusion Model B\", \"checkpoints/qwen/LoRA_Fusion_Model_B\"),\n",
    "    (\"Sequential Fine-Tuned Model B\", \"checkpoints/qwen/E10_Model_B_English_Ekegusii\"),\n",
    "    (\"Instant LoRA Fusion Model C\", \"checkpoints/qwen/LoRA_Fusion_Model_C\"),\n",
    "    (\"Sequential Fine-Tuned Model C\", \"checkpoints/qwen/E10_Model_C_Swahili_Ekegusii\"),\n",
    "]\n",
    "\n",
    "for name, path in models_to_eval:\n",
    "    if os.path.exists(path):\n",
    "        try:\n",
    "            metrics = run_evaluate(model_name=\"qwen\", source_lang=\"English\", target_lang=\"Ekegusii\", adapter_path=path)\n",
    "            results.append({\n",
    "                \"Architecture Approach\": name,\n",
    "                \"Direction\": \"English->Ekegusii\",\n",
    "                \"SacreBLEU\": round(metrics.get(\"score\", metrics.get(\"bleu\", 0.0)), 2),\n",
    "                \"chrF++\": round(metrics.get(\"chrf\", 0.0), 2),\n",
    "                \"Lexical_Accuracy\": round(metrics.get(\"lexical_accuracy\", 0.0), 2)\n",
    "            })\
    "        except Exception as e:\n",
    "            print(f\"Notice on {name}: {e}\")\n",
    "\n",
    "df_comparison = pd.DataFrame(results)\n",
    "print(\"\\n\" + \"=\" * 75)\n",
    "print(\"📊 COMPARISON TABLE: Fine-Tuning vs. Instant LoRA Fusion\")\n",
    "print(\"=\" * 75)\n",
    "display(df_comparison)\n",
    "\n",
    "os.makedirs(\"outputs/evaluation_reports\", exist_ok=True)\n",
    "df_comparison.to_csv(\"outputs/evaluation_reports/fusion_vs_finetuning_results.csv\", index=False)\n",
    "print(\"✅ Saved comparison report to outputs/evaluation_reports/fusion_vs_finetuning_results.csv\")\n"
   ]
  }
 ],
